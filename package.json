{
  "name": "@open-ayame/ayame-web-sdk",
  "version": "2026.0.0",
  "description": "WebRTC Signaling Server Ayame Web SDK",
  "homepage": "https://github.com/OpenAyame/ayame-web-sdk",
  "bugs": {
    "url": "https://discord.gg/shiguredo"
  },
  "license": "Apache-2.0",
  "author": "Shiguredo Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAyame/ayame-web-sdk.git"
  },
  "directories": {
    "doc": "docs/"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "dist/ayame.js",
  "types": "dist/ayame.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ayame.d.ts",
      "import": "./dist/ayame.js"
    }
  },
  "scripts": {
    "build": "vp build",
    "watch": "vp build --watch",
    "dev": "vp dev --config devtools/vite.config.ts",
    "build:devtools": "vp build --config devtools/vite.config.ts",
    "preview:devtools": "vp preview --config devtools/vite.config.ts",
    "build:typedoc": "cd tooling/typedoc && vp exec typedoc",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "typecheck": "tsc --noEmit",
    "dist": "vp run clean && vp install && vp build",
    "clean": "git clean -ffdx -e .env.local -e .env",
    "test": "vp exec playwright test --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "26.2.0",
    "@types/webrtc": "0.0.47",
    "@typescript/typescript6": "6.0.2",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.9",
    "vite-plugin-dts": "5.0.3",
    "vite-plus": "0.2.9"
  },
  "engines": {
    "node": ">=22",
    "vp": ">=0.1"
  },
  "packageManager": "pnpm@10.33.0"
}
