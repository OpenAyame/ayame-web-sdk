{
  "name": "@open-ayame/ayame-web-sdk",
  "version": "2024.1.0-canary.0",
  "description": "WebRTC Signaling Server Ayame Web SDK",
  "type": "module",
  "module": "dist/ayame.mjs",
  "exports": {
    ".": {
      "types": "./dist/ayame.d.ts",
      "import": "./dist/ayame.mjs",
      "require": "./dist/ayame.mjs"
    }
  },
  "types": "dist/ayame.d.ts",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "dev": "vite --config examples/vite.config.mjs",
    "lint": "biome lint ./src",
    "fmt": "biome format --write ./src",
    "doc": "typedoc",
    "deploy:docs": "pnpx gh-pages -d apidoc"
  },
  "bugs": {
    "url": "https://discord.gg/shiguredo"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAyame/ayame-web-sdk.git"
  },
  "directories": {
    "doc": "docs/"
  },
  "homepage": "https://github.com/OpenAyame/ayame-web-sdk",
  "author": "Shiguredo Inc.",
  "license": "Apache-2.0",
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/node": "22.10.2",
    "@types/webrtc": "0.0.44",
    "gh-pages": "6.2.0",
    "playwright": "1.49.1",
    "typedoc": "0.27.5",
    "typescript": "5.7.2",
    "vite": "6.0.3",
    "vite-plugin-dts": "4.3.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=18"
  }
}