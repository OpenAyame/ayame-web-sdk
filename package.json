{
  "name": "@open-ayame/ayame-web-sdk",
  "version": "2025.1.1",
  "description": "WebRTC Signaling Server Ayame Web SDK",
  "homepage": "https://github.com/OpenAyame/ayame-web-sdk",
  "bugs": {
    "url": "https://discord.gg/shiguredo"
  },
  "license": "Apache-2.0",
  "author": "Shiguredo Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenAyame/ayame-web-sdk.git"
  },
  "directories": {
    "doc": "docs/"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "module": "dist/ayame.mjs",
  "exports": {
    ".": {
      "types": "./dist/ayame.d.ts",
      "import": "./dist/ayame.mjs",
      "require": "./dist/ayame.mjs"
    }
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "dev": "vite --config devtools/vite.config.ts",
    "build:devtools": "vite build --config devtools/vite.config.ts",
    "preview:devtools": "vite preview --config devtools/vite.config.ts",
    "build:typedoc": "typedoc",
    "fmt": "oxfmt --write .",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit",
    "dist": "pnpm clean && pnpm install && pnpm build",
    "clean": "git clean -ffdx -e .env.local -e .env",
    "test": "playwright test --project=chromium"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "25.3.5",
    "@types/webrtc": "0.0.47",
    "oxfmt": "0.36.0",
    "oxlint": "1.51.0",
    "oxlint-tsgolint": "0.16.0",
    "typedoc": "0.28.17",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vite-plugin-dts": "4.5.4"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  }
}
